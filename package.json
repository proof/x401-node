{
  "name": "@proof.com/x401-node",
  "version": "0.1.0",
  "description": "Node.js SDK for the x401 protocol.",
  "keywords": [
    "x401",
    "HTTP",
    "Verifiable Presentation",
    "OID4VP",
    "DCQL",
    "Agent",
    "Verifier",
    "Proof",
    "Proof.com"
  ],
  "homepage": "https://github.com/proof/x401-node",
  "bugs": "https://github.com/proof/x401-node/issues",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/proof/x401-node.git"
  },
  "license": "Apache-2.0",
  "author": "Jeremie Charrier <jeremie.charrier@proof.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check-all": "yarn format && yarn lint && yarn typecheck && yarn test && yarn publint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "publint": "publint --pack npm",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@owf/identity-common": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.4",
    "prettier-plugin-packagejson": "^3.0.2",
    "publint": "^0.3.21",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
